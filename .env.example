# Database Connection (Supabase PostgreSQL via Transaction/Session Pooler)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Server Configuration
PORT=5000
NODE_ENV=development

# Security & CORS
FRONTEND_ORIGIN="http://localhost:5173,https://your-frontend.vercel.app"
SESSION_SECRET="your-super-secret-session-key-change-in-production"

# Supabase Storage (Private Bucket — gunakan Service Role Key, BUKAN Anon Key)
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Konfigurasi Bucket Supabase Storage
SUPABASE_TEMPLATE_BUCKET="templates"
SUPABASE_TEMPLATE_PATH="templates-excel/template_pertumbuhan.xlsx"
SUPABASE_REPORTS_BUCKET="reports"

# Logging
LOG_LEVEL="debug"
